#include <stdio.h>

int revNum(int num)
{
    int rev = 0, rem;
    while (num != 0)
    {
        rem = num % 10;
        rev = rev * 10 + rem;
        num /= 10;
    }
    return rev;
}

int main()
{
    int num;
    printf("Enter a 3 digit number: ");
    scanf("%d", &num);

    int revnum = revNum(num);

    printf("Reverse number: %d\n", revnum);

    return 0;
}
