#include <stdio.h>
// que 1

int main() {
    char ch;

    printf("Enter an alphabet: ");
    scanf("%c", &ch);

    switch(ch) {
        case 'a':
        case 'e':
        case 'i':
        case 'o':
        case 'u':
        case 'A':
        case 'E':
        case 'I':
        case 'O':
        case 'U':
            printf("Vowel", ch);
            break;

        default:
            printf("Consonant", ch);
    }

    return 0;
}
